 }
 
+export interface UserSummary {
+  id: string;
+  username: string;
+  emailVerified: boolean;
+}
+
+// What /login and /register return. NOTE the field is "accessToken",
+// not "token" (only the GitHub/Discord redirect uses #token=...).
+export interface AuthResponse {
+  accessToken: string;
+  tokenType: string;
+  expiresInMs: number;
+  user: UserSummary;
+}
+
